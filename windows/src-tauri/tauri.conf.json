{
  "build": {
    "distDir": "../ui",
    "devPath": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "ClevVPN",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "shell": { "open": true }
    },
    "bundle": {
      "active": true,
      "identifier": "com.clevvpn.windows",
      "targets": ["nsis"],
      "resources": ["bin/*"],
      "icon": ["icons/icon.ico"],
      "windows": {
        "nsis": { "installMode": "perMachine" }
      }
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "ClevVPN",
        "width": 420,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
