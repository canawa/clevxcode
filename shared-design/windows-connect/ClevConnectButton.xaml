<UserControl x:Class="ClevVPN.Controls.ClevConnectButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="220"
             ClipToBounds="False"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Cursor="Hand">
    <!--
      Port of ClevVPN/Theme/Components.swift ConnectButton (Mac size: 150)
      ringSize = 174, rim = 150, plate = 111, power = 33
      Glow layers sit BEHIND crisp geometry — never Effect on the yellow plate.
    -->
    <Grid ClipToBounds="False" UseLayoutRounding="False">
        <!-- Soft ambient glow (Mac rim.shadow logoYellow 0.35 r=30 + StatusGlow) -->
        <Ellipse x:Name="RimGlow"
                 Width="210" Height="210"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#59FAC300" Offset="0" />
                    <GradientStop Color="#28FAC300" Offset="0.45" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="Root"
              Width="182" Height="182"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ClipToBounds="False"
              UseLayoutRounding="False"
              RenderTransformOrigin="0.5,0.5"
              IsHitTestVisible="False">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- ConnectBurst -->
            <Grid x:Name="BurstLayer"
                  Width="174" Height="174"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Ellipse x:Name="BurstRing0" Width="174" Height="174"
                         Stroke="#8CFAC300" StrokeThickness="2" Fill="Transparent"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BurstRing0Scale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BurstRing1" Width="174" Height="174"
                         Stroke="#8CFAC300" StrokeThickness="2" Fill="Transparent"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BurstRing1Scale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BurstRing2" Width="174" Height="174"
                         Stroke="#8CFAC300" StrokeThickness="2" Fill="Transparent"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BurstRing2Scale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BurstFlash" Width="174" Height="174"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#F2FFFFFF" Offset="0" />
                            <GradientStop Color="#66FAC300" Offset="0.45" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BurstFlashScale" ScaleX="0.5" ScaleY="0.5" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path x:Name="BurstBolt"
                      Width="59" Height="59"
                      Stretch="Uniform"
                      Fill="White"
                      Opacity="0"
                      Data="{StaticResource IconBoltFillSf}"
                      RenderTransformOrigin="0.5,0.5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="BurstBoltScale" ScaleX="0.5" ScaleY="0.5" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- Drop shadow under rim (Mac: black 0.6 r=10 y=6) — blurred ellipse BEHIND -->
            <Ellipse Width="150" Height="150"
                     Fill="#99000000"
                     Margin="0,10,0,-10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Opacity="0.55">
                <Ellipse.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- outerLine track -->
            <Ellipse x:Name="OuterOutline"
                     Width="174" Height="174"
                     Stroke="#8C2A2A31"
                     StrokeThickness="1.5"
                     Fill="Transparent"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

            <!-- rim 150 — crisp, NO Effect -->
            <Grid Width="150" Height="150"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Ellipse x:Name="RimEllipse">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#30303A" Offset="0" />
                            <GradientStop Color="#121217" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Stroke="#0FFFFFFF" StrokeThickness="1" Fill="Transparent" />
            </Grid>

            <!-- plate glow behind plate (Mac plate.shadow yellow 0.4 r=12) -->
            <Ellipse x:Name="PlateGlow"
                     Width="130" Height="130"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#66FAC300" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- plate 111 — crisp radial, clipped -->
            <Grid x:Name="PlateHost"
                  Width="111" Height="111"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ClipToBounds="True">
                <Grid.Clip>
                    <EllipseGeometry Center="55.5,55.5" RadiusX="55.5" RadiusY="55.5" />
                </Grid.Clip>
                <Ellipse x:Name="PlateEllipse">
                    <Ellipse.Fill>
                        <!--
                          Mac Components.swift plateRadial:
                            RadialGradient([logoYellow #FAC300, logoAmber #E39A00],
                              center: (0.5, 0.42),
                              startRadius: d*0.05, endRadius: d*0.6)
                          WPF RadiusX is fraction of element width (= d) → 0.6
                        -->
                        <RadialGradientBrush x:Name="PlateBrush"
                                             GradientOrigin="0.5,0.42"
                                             Center="0.5,0.42"
                                             RadiusX="0.6"
                                             RadiusY="0.6"
                                             SpreadMethod="Pad">
                            <GradientStop x:Name="PlateStop0" Color="#24242E" Offset="0" />
                            <GradientStop x:Name="PlateStopMid" Color="#24242E" Offset="0.083" />
                            <GradientStop x:Name="PlateStop1" Color="#0C0C11" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Mac plateTopLight: on white 0.3, off white 0.10 → clear at y=0.45 -->
                <Ellipse IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.45">
                            <GradientStop x:Name="PlateTopLightStop" Color="#1AFFFFFF" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Stroke="#73000000" StrokeThickness="1.5" Fill="Transparent" />
            </Grid>

            <!-- Fill ring on -->
            <Ellipse x:Name="FillRing"
                     Width="174" Height="174"
                     StrokeThickness="2"
                     Fill="Transparent"
                     StrokeStartLineCap="Round"
                     StrokeEndLineCap="Round"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5"
                     Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAC300" Offset="0" />
                        <GradientStop Color="#E39A00" Offset="0.5" />
                        <GradientStop Color="#FAC300" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="CometRing"
                     Width="174" Height="174"
                     StrokeThickness="2.5"
                     Fill="Transparent"
                     StrokeStartLineCap="Round"
                     StrokeEndLineCap="Round"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5"
                     Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#B3FAC300" Offset="0.55" />
                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="CometRotate" Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BusyRing"
                     Width="174" Height="174"
                     StrokeThickness="2.5"
                     Fill="Transparent"
                     StrokeStartLineCap="Round"
                     StrokeEndLineCap="Round"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5"
                     Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#80E39A00" Offset="0.5" />
                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="BusyRotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- content — Mac VStack spacing on:7 / off:6 -->
            <StackPanel x:Name="ContentStack"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <!-- Mac: power SF Symbol weight .light → stroke, not filled glyph -->
                <Viewbox Width="33" Height="33" Stretch="Uniform" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PowerIcon"
                              Stroke="#9A9AA3"
                              StrokeThickness="1.55"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Data="M12,3.2 L12,12.2 M7.15,7.15 A6.35,6.35 0 1 0 16.85,7.15" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="ConnectLabel"
                           Text="Start"
                           FontSize="11.25"
                           FontWeight="Normal"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           Foreground="#9A9AA3"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           TextOptions.TextFormattingMode="Display" />
                <TextBlock x:Name="SessionTimerText"
                           Text=""
                           FontSize="16.5"
                           FontWeight="Light"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           Foreground="#B3000000"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"
                           Visibility="Collapsed"
                           TextOptions.TextFormattingMode="Display" />
            </StackPanel>
        </Grid>

        <Ellipse x:Name="HitTarget"
                 Width="182" Height="182"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 MouseLeftButtonDown="HitTarget_MouseLeftButtonDown"
                 MouseLeftButtonUp="HitTarget_MouseLeftButtonUp"
                 MouseLeave="HitTarget_MouseLeave" />
    </Grid>
</UserControl>
